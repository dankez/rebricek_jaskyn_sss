# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Set private credentials for Express; production rejects blank values.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Required in production; generate with: openssl rand -hex 32
SESSION_SECRET=""

# HTTP server port
PORT="3000"

# Public HTTPS origin. Required by production for sitemap generation and deployment safety.
# AI Studio may inject the Cloud Run service URL at runtime.
APP_URL="MY_APP_URL"
